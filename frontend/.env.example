# Enviroment variables needed to connect to the LiveKit server.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

# Visual design / theme. One of: dark-green (default) | light | dark
# Read server-side at runtime, so changing it only needs a frontend restart
# (no rebuild). Applied as <html data-design="…"> in app/layout.tsx.
DESIGN=dark-green

# Isolated /elevenlabs-test page (development only).
# Put real values in .env.local and restart Next.js. Never use NEXT_PUBLIC_ for keys.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Configure the Huawei MaaS custom LLM and its secret in the ElevenLabs dashboard.
